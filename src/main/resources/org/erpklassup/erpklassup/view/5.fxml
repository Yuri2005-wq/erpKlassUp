<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" styleClass="rbac-tab-content" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controller.UtilisateursTabController">

    <!-- ===== Barre d'outils : recherche + filtres + actions ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="rbac-toolbar">

        <!-- Recherche instantanée -->
        <StackPane styleClass="search-field-container">
            <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-field-icon" StackPane.alignment="CENTER_LEFT" />
            <TextField fx:id="searchField" promptText="Rechercher un nom, un email, un identifiant..." styleClass="search-field" />
        </StackPane>

        <ComboBox fx:id="filterRole" promptText="Rôle" styleClass="filter-combo" />
        <ComboBox fx:id="filterStatut" promptText="Statut" styleClass="filter-combo" />
        <ComboBox fx:id="filterEcole" promptText="Établissement" styleClass="filter-combo" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnActionsGroupees" onAction="#handleActionsGroupees" styleClass="btn-secondary" text="Actions par lot">
            <graphic><FontIcon iconLiteral="fth-layers" iconSize="14" /></graphic>
        </Button>

        <Button fx:id="btnAjouterUtilisateur" onAction="#handleAjouterUtilisateur" styleClass="btn-primary" text="Ajouter un utilisateur">
            <graphic><FontIcon iconLiteral="fth-plus" iconSize="14" /></graphic>
        </Button>

    </HBox>

    <!-- ===== Tableau des utilisateurs ===== -->
    <TableView fx:id="tableUtilisateurs" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>

            <TableColumn fx:id="colSelect" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" sortable="false">
                <graphic><CheckBox fx:id="checkAllUsers" onAction="#handleSelectAll" /></graphic>
            </TableColumn>

            <TableColumn fx:id="colUtilisateur" minWidth="240.0" prefWidth="280.0" text="Utilisateur" />

            <TableColumn fx:id="colRole" minWidth="140.0" prefWidth="150.0" text="Rôle" />

            <TableColumn fx:id="colStatut" minWidth="110.0" prefWidth="120.0" text="Statut" />

            <TableColumn fx:id="colSecurite" maxWidth="90.0" minWidth="90.0" prefWidth="90.0" sortable="false" text="2FA" />

            <TableColumn fx:id="colDerniereConnexion" minWidth="160.0" prefWidth="170.0" text="Dernière connexion" />

            <TableColumn fx:id="colActions" maxWidth="60.0" minWidth="60.0" prefWidth="60.0" sortable="false" text="" />

        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_LAST_COLUMN" />
        </columnResizePolicy>
    </TableView>

    <!-- ===== Pied de tableau : compteur + pagination ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="rbac-table-footer">
        <Label fx:id="labelCompteurResultats" styleClass="muted-text" text="0 utilisateur(s)" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnPagePrecedente" onAction="#handlePagePrecedente" styleClass="btn-icon">
            <graphic><FontIcon iconLiteral="fth-chevron-left" iconSize="14" /></graphic>
        </Button>
        <Label fx:id="labelPage" text="Page 1 / 1" />
        <Button fx:id="btnPageSuivante" onAction="#handlePageSuivante" styleClass="btn-icon">
            <graphic><FontIcon iconLiteral="fth-chevron-right" iconSize="14" /></graphic>
        </Button>
    </HBox>

</VBox>
