<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="settingsRoot" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.renduView.SettingsTabControllers">

    <VBox style="-fx-background-color: #111a2e;">
        <children>

            <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="5.0" style="-fx-background-color: #16213A; -fx-padding: 0; -fx-border-color: #2A3B61; -fx-border-width: 0 0 1 0;">
                <children>
                    <Button fx:id="btnTabUtilisateur" onAction="#switchTab" styleClass="top-tab-btn" text="Utilisateur">
                        <graphic>
                            <FontIcon iconLiteral="fth-users" iconSize="16" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnTabRolePermissions" onAction="#switchTab" styleClass="top-tab-btn" text="Role &amp; Permission">
                        <graphic>
                            <FontIcon iconLiteral="fth-key" iconSize="16" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnTabAudits" onAction="#switchTab" styleClass="top-tab-btn" text="Journal d'Audits">
                        <graphic>
                            <FontIcon iconLiteral="fth-activity" iconSize="16" />
                        </graphic>
                    </Button>
                </children>
            </HBox>

            <StackPane fx:id="tabContentContainer" style="-fx-padding: 5;" styleClass="content-area" VBox.vgrow="ALWAYS" />

        </children>
    </VBox>
</StackPane>
