<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootStack" styleClass="content-area" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.GRH.PosteController">

    <VBox spacing="16" styleClass="content-area">
        <padding>
            <Insets bottom="20" left="24" right="24" top="20" />
        </padding>

        <!-- Barre d'outils : recherche, filtres, actions -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-toolbar">

            <HBox alignment="CENTER_LEFT" styleClass="search-box-light">
                <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-icon-light" />
                <StackPane HBox.hgrow="ALWAYS">
                    <TextField fx:id="fieldRecherche" promptText="Rechercher un poste..." styleClass="search-field-inner, search-field-with-clear" />
                    <Button fx:id="btnClearSearch" styleClass="btn-clear-search" visible="false" StackPane.alignment="CENTER_RIGHT">
                        <graphic><FontIcon iconLiteral="fth-x" iconSize="11" /></graphic>
                        <StackPane.margin><Insets right="4.0" /></StackPane.margin>
                    </Button>
                </StackPane>
            </HBox>

            <ComboBox fx:id="filtreCategorie" promptText="Catégorie" styleClass="combo-box" />
            <ComboBox fx:id="filtreStatut" promptText="Statut" styleClass="combo-box" />
         <ComboBox fx:id="filtreDepartement" layoutX="450.0" layoutY="14.0" promptText="Departement" styleClass="combo-box" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Action primaire : création -->
            <Button fx:id="btnNouveauPoste" onAction="#onNouveauPoste" styleClass="button-primary" text="Nouveau poste">
                <graphic>
                    <FontIcon iconLiteral="fth-plus-circle" />
                </graphic>
            </Button>
        </HBox>

        <!-- Tableau principal -->
        <TableView fx:id="tablePostes" prefHeight="402.0" prefWidth="1006.0" style="-fx-background-color: white;" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label styleClass="table-placeholder" text="Aucun poste enregistré pour cette école" />
            </placeholder>
            <columns>
                <TableColumn fx:id="colPosteIntitule" prefWidth="180.0" text="Intitulé" />
                <TableColumn fx:id="colPosteDepartement" prefWidth="160.0" text="Département" />
                <TableColumn fx:id="colPosteCategorie" prefWidth="130.0" text="Catégorie" />
                <TableColumn fx:id="colPosteDescription" prefWidth="220.0" text="Description" />
                <TableColumn fx:id="colPosteEffectif" prefWidth="80.0" text="Effectif" />
                <TableColumn fx:id="colPosteStatut" prefWidth="70.0" text="Statut" />
                <TableColumn fx:id="colPosteActions" prefWidth="140.0" text="Actions" />
            </columns>
        </TableView>

        <!-- Pied : compteur + pagination -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblFooterPostes" styleClass="footer-info" text="0 poste" />
            <Region HBox.hgrow="ALWAYS" />
            <Pagination fx:id="paginationPostes" maxPageIndicatorCount="5" styleClass="custom-pagination" />
            <padding>
                <Insets bottom="-10.0" top="-10.0" />
            </padding>
            <VBox.margin>
                <Insets bottom="-15.0" top="-15.0" />
            </VBox.margin>
        </HBox>
    </VBox>

</StackPane>
