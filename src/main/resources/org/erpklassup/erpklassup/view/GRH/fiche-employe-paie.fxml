<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.erpklassup.erpklassup.controllers.actionPage.GRH.FichePersonnelController" spacing="14">
    <padding>
        <Insets bottom="14"/>
    </padding>

    <HBox spacing="14">
        <VBox styleClass="fiche-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Salaire de base" styleClass="metrique-libelle"/>
            <Label fx:id="lblSalaireBase" styleClass="metrique-valeur"/>
        </VBox>
        <VBox styleClass="fiche-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Dernier net" styleClass="metrique-libelle"/>
            <Label fx:id="lblDernierNet" styleClass="metrique-valeur"/>
        </VBox>
        <VBox styleClass="fiche-card" spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Avances restant à rembourser" styleClass="metrique-libelle"/>
            <Label fx:id="lblAvances" styleClass="metrique-valeur"/>
        </VBox>
    </HBox>

    <VBox styleClass="fiche-card, carte-table" VBox.vgrow="ALWAYS">
        <HBox styleClass="carte-entete">
            <Label text="Bulletins de paie" styleClass="carte-titre"/>
        </HBox>
        <TableView fx:id="tableBulletins" styleClass="fiche-table" fixedCellSize="42" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun bulletin généré"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colPeriode" text="Période" prefWidth="150" sortable="false"/>
                <TableColumn fx:id="colBrut" text="Brut" prefWidth="130" sortable="false"
                             style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colRetenues" text="Retenues" prefWidth="130" sortable="false"
                             style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colNet" text="Net à payer" prefWidth="140" sortable="false"
                             style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colBullStatut" text="Statut" prefWidth="100" sortable="false"/>
                <TableColumn fx:id="colBullAction" text="PDF" prefWidth="60" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
