<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="SettingRoot" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.renduView.RH.RhTabControllers">

    <VBox style="-fx-background-color: #111a2e;">
        <children>

            <!-- ===== BARRE D'ONGLETS ===== -->
            <HBox alignment="CENTER_LEFT" prefHeight="36.0" prefWidth="1000.0" spacing="5.0" style="-fx-background-color: #16213A; -fx-padding: 0; -fx-border-color: #2A3B61; -fx-border-width: 0 0 1 0;">
                <children>
                    <Button fx:id="btnTableau" onAction="#switchTab" styleClass="top-tab-btn" text="Tableau de Bord RH">
                        <graphic>
                            <FontIcon iconLiteral="fth-grid" iconSize="16" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnListePersonnel" onAction="#switchTab" styleClass="top-tab-btn" text="Liste du personnel">
                        <graphic>
                            <FontIcon iconLiteral="fas-user-tie" iconSize="16" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnDepartements" onAction="#switchTab" styleClass="top-tab-btn" text="Départements">
                        <graphic>
                            <FontIcon iconLiteral="fas-sitemap" iconSize="16" />
                        </graphic>
                    </Button>
                    <Button fx:id="btnPostes" onAction="#switchTab" styleClass="top-tab-btn" text="Postes">
                        <graphic>
                            <FontIcon iconLiteral="fth-briefcase" iconSize="16" />
                        </graphic>
                    </Button>

                </children>
            </HBox>

            <StackPane fx:id="tabContentContainer" style="-fx-padding: 5;" styleClass="content-area" VBox.vgrow="ALWAYS" />

        </children>
    </VBox>
</StackPane>
