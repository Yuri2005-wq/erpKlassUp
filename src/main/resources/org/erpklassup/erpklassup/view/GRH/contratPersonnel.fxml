<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" styleClass="root-pane" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.GRH.ContratPersonnelController">
    <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

    <!-- EN-TÊTE : Nom du personnel -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <FontIcon iconLiteral="fth-file-text" iconSize="24" styleClass="icon-orange" />
        <VBox spacing="2">
            <Label fx:id="lblNomPersonnel" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16213A;" text="Contrats de l'employé" />
            <Label fx:id="lblPostePersonnel" style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Chargement..." />
        </VBox>
    </HBox>

    <!-- TOOLBAR -->
    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-toolbar">
        <HBox alignment="CENTER_LEFT" maxWidth="340.0" prefWidth="340.0" spacing="8.0" styleClass="search-box-light">
            <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-icon-light" />
            <TextField fx:id="searchField" promptText="Rechercher un contrat (n°...)" styleClass="search-field-inner" HBox.hgrow="ALWAYS" />
        </HBox>

        <ComboBox fx:id="filtreStatut" prefWidth="150" promptText="Tous les statuts" styleClass="combo-box" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnNouveauContrat" styleClass="button-primary" text="Nouveau contrat">
            <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" /></graphic>
        </Button>
    </HBox>

    <!-- TABLEAU DES CONTRATS -->
    <TableView fx:id="tableContrats" styleClass="custom-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" prefWidth="150" text="N° Contrat" />
            <TableColumn fx:id="colType" prefWidth="120" text="Type" />
            <TableColumn fx:id="colDebut" prefWidth="120" text="Début" />
            <TableColumn fx:id="colFin" prefWidth="120" text="Fin" />
            <TableColumn fx:id="colSalaire" prefWidth="150" text="Salaire de base" />
            <TableColumn fx:id="colStatut" prefWidth="120" text="Statut" />
            <TableColumn fx:id="colActions" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;" text="Actions" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <placeholder>
            <VBox alignment="CENTER" spacing="8">
                <FontIcon iconLiteral="fth-file" iconSize="32" styleClass="icon-gray" />
                <Label styleClass="table-placeholder" text="Aucun contrat trouvé pour cet employé." />
            </VBox>
        </placeholder>
    </TableView>

</VBox>
