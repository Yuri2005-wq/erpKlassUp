<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" styleClass="root-pane" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.GRH.ConfigurationRHPaieController">
    <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

    <!-- EN-TÊTE -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <FontIcon iconLiteral="fth-settings" iconSize="24" styleClass="icon-orange" />
        <VBox spacing="2">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16213A;" text="Configuration RH et Paie" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Paramétrez les règles métier, les grilles salariales et les barèmes légaux." />
        </VBox>
    </HBox>

    <!-- ONGLETS DE CONFIGURATION -->
    <TabPane fx:id="tabPaneConfig" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <!-- ONGLET 1 : GRADES SALARIAUX -->
            <Tab closable="false" text="Grades Salariaux">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="14" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAjouterGrade" styleClass="button-primary" text="Nouveau Grade">
                                <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" /></graphic>
                            </Button>
                        </HBox>
                        <TableView fx:id="tableGrades" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colGradeCode" prefWidth="100" text="Code" />
                                <TableColumn fx:id="colGradeLibelle" prefWidth="200" text="Libellé" />
                                <TableColumn fx:id="colGradeCategorie" prefWidth="120" text="Catégorie" />
                                <TableColumn fx:id="colGradeEchelon" prefWidth="100" text="Échelon" />
                                <TableColumn fx:id="colGradeSalaire" prefWidth="150" text="Salaire de Référence" />
                                <TableColumn fx:id="colGradeActions" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;" text="Actions" />
                            </columns>
                            <placeholder>
                                <Label styleClass="table-placeholder" text="Aucun grade configuré." />
                            </placeholder>
                        </TableView>
                    </VBox>
                </content>
            </Tab>

            <!-- ONGLET 2 : RUBRIQUES DE PAIE -->
            <Tab closable="false" text="Rubriques de Paie">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="14" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAjouterRubrique" styleClass="button-primary" text="Nouvelle Rubrique">
                                <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" /></graphic>
                            </Button>
                        </HBox>
                        <TableView fx:id="tableRubriques" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRubCode" prefWidth="100" text="Code" />
                                <TableColumn fx:id="colRubLibelle" prefWidth="200" text="Libellé" />
                                <TableColumn fx:id="colRubType" prefWidth="120" text="Type (GAIN/RETENUE)" />
                                <TableColumn fx:id="colRubMode" prefWidth="120" text="Mode de calcul" />
                                <TableColumn fx:id="colRubValeur" prefWidth="100" text="Valeur par défaut" />
                                <TableColumn fx:id="colRubImposable" prefWidth="100" text="Imposable ?" />
                                <TableColumn fx:id="colRubActions" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;" text="Actions" />
                            </columns>
                            <placeholder>
                                <Label styleClass="table-placeholder" text="Aucune rubrique configurée." />
                            </placeholder>
                        </TableView>
                    </VBox>
                </content>
            </Tab>

            <!-- ONGLET 3 : PARAMÈTRES LÉGAUX (CNPS, etc.) -->
            <Tab closable="false" text="Paramètres Légaux">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="14" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAjouterParametre" styleClass="button-primary" text="Nouveau Paramètre">
                                <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" /></graphic>
                            </Button>
                        </HBox>
                        <TableView fx:id="tableParametres" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colParCode" prefWidth="150" text="Code (ex: CNPS_SAL)" />
                                <TableColumn fx:id="colParLibelle" prefWidth="200" text="Libellé" />
                                <TableColumn fx:id="colParValeur" prefWidth="120" text="Valeur" />
                                <TableColumn fx:id="colParUnite" prefWidth="100" text="Unité" />
                                <TableColumn fx:id="colParDateEffet" prefWidth="120" text="Date d'effet" />
                                <TableColumn fx:id="colParActions" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;" text="Actions" />
                            </columns>
                            <placeholder>
                                <Label styleClass="table-placeholder" text="Aucun paramètre légal configuré." />
                            </placeholder>
                        </TableView>
                    </VBox>
                </content>
            </Tab>

            <!-- ONGLET 4 : BARÈMES D'IMPÔT (IRPP) -->
            <Tab closable="false" text="Barèmes d'Impôt">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="14" /></padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <ComboBox fx:id="filtreBareme" prefWidth="200" promptText="Sélectionner un barème" styleClass="combo-box" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAjouterTranche" styleClass="button-primary" text="Nouvelle Tranche">
                                <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" /></graphic>
                            </Button>
                        </HBox>
                        <TableView fx:id="tableTranches" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTrBareme" prefWidth="120" text="Barème (ex: IRPP)" />
                                <TableColumn fx:id="colTrBorneInf" prefWidth="150" text="Borne Inférieure" />
                                <TableColumn fx:id="colTrBorneSup" prefWidth="150" text="Borne Supérieure" />
                                <TableColumn fx:id="colTrTaux" prefWidth="100" text="Taux (%)" />
                                <TableColumn fx:id="colTrDateEffet" prefWidth="120" text="Date d'effet" />
                                <TableColumn fx:id="colTrActions" prefWidth="100" sortable="false" style="-fx-alignment: CENTER;" text="Actions" />
                            </columns>
                            <placeholder>
                                <Label styleClass="table-placeholder" text="Aucune tranche configurée." />
                            </placeholder>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
        </tabs>
        <styleClass>
            <String fx:value="top-tab-pane" />
            <String fx:value="tabs-arrondis-structure" />
        </styleClass>
    </TabPane>
</VBox>
