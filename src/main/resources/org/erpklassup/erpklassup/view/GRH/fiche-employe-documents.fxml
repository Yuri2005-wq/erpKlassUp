<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.erpklassup.erpklassup.controllers.actionPage.GRH.FichePersonnelController" spacing="14">
    <padding>
        <Insets bottom="14"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label text="Pièces et documents du dossier" styleClass="carte-titre"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Ajouter un document" styleClass="btn-primaire" >
            <graphic><FontIcon iconLiteral="fth-upload"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="fiche-card, carte-table" VBox.vgrow="ALWAYS">
        <TableView fx:id="tableDocuments" styleClass="fiche-table" fixedCellSize="42" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Aucun document dans ce dossier"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colDocType" text="Type" prefWidth="150" sortable="false"/>
                <TableColumn fx:id="colDocNom" text="Nom du fichier" prefWidth="320" sortable="false"/>
                <TableColumn fx:id="colDocDate" text="Ajouté le" prefWidth="120" sortable="false"/>
                <TableColumn fx:id="colDocAction" text="Ouvrir" prefWidth="70" sortable="false"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
