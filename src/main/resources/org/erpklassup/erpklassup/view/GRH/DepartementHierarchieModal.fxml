<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefHeight="600.0" prefWidth="597.0" spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 8);" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.GRH.DepartementHierarchieModalController">

    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>

    <children>
        <!-- En-tête -->
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <FontIcon iconLiteral="fas-sitemap" iconSize="32" styleClass="icon-orange" />
                <VBox spacing="2.0">
                    <children>
                        <Label text="Organigramme Hiérarchique" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label text="Structure des départements et sous-départements" textFill="#64748B">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnDeplierTout" styleClass="btn-icon-light" text="Déplier tout">
                    <graphic>
                        <FontIcon iconLiteral="fth-chevron-down" iconSize="12" />
                    </graphic>
                </Button>
                <Button fx:id="btnReplierTout" styleClass="btn-icon-light" text="Replier tout">
                    <graphic>
                        <FontIcon iconLiteral="fth-chevron-up" iconSize="12" />
                    </graphic>
                </Button>
            </children>
        </HBox>

        <Separator />

        <!-- Arbre Hiérarchique : VBox.vgrow au lieu de VBox.hgrow -->
        <TreeView fx:id="treeDepartements" styleClass="custom-tree-view" VBox.vgrow="ALWAYS" />

        <!-- Actions / Fermeture -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button fx:id="btnFermer" onAction="#handleFermer" styleClass="button-primary" text="Fermer">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
