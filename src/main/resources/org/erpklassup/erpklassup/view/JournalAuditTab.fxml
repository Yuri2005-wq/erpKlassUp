<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" styleClass="card" stylesheets="@../style.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.erpklassup.erpklassup.controllers.actionPage.JournalAuditTabController">

    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
    </padding>

    <!-- ===== Filtres du journal ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="page-toolbar">
        <children>

            <HBox alignment="CENTER_LEFT" maxWidth="340.0" prefWidth="340.0" spacing="8.0" styleClass="search-box-light">
                <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-icon-light" />

                <StackPane HBox.hgrow="ALWAYS">
                    <TextField fx:id="searchAudit" promptText="%audit.search.placeholder"
                               styleClass="search-field-inner, search-field-with-clear" />
                    <Button fx:id="btnClearSearch" styleClass="btn-clear-search" visible="false"
                            StackPane.alignment="CENTER_RIGHT">
                        <graphic><FontIcon iconLiteral="fth-x" iconSize="11" /></graphic>
                        <StackPane.margin><Insets right="4.0" /></StackPane.margin>
                    </Button>
                </StackPane>
            </HBox>

            <DatePicker fx:id="datePickerDebut" promptText="%audit.date.from" styleClass="date-picker-custom" />
            <DatePicker fx:id="datePickerFin" promptText="%audit.date.to" styleClass="date-picker-custom" />

            <ComboBox fx:id="filterTypeAction" maxWidth="180.0" prefWidth="180.0"
                      promptText="%audit.filter.type" styleClass="filter-combo" />

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnExporterAudit" styleClass="btn-secondary" text="%audit.export.button">
                <graphic>
                    <FontIcon iconLiteral="fth-download" iconSize="14" styleClass="btn-icon" />
                </graphic>
            </Button>
        </children>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="6">

        <!-- Card Total -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER" spacing="4">
                <FontIcon iconLiteral="fth-activity" iconSize="11" />
                <Label fx:id="statTotalLabel" styleClass="stat-number" text="0" />
            </HBox>
            <Label styleClass="stat-card-label" text="%audit.stats.total" />
            <styleClass>
                <String fx:value="stat-card-compact" />
                <String fx:value="special-container" />
            </styleClass>
        </VBox>

        <!-- Card Autorisé -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER" spacing="4">
                <FontIcon iconLiteral="fth-check-circle" iconSize="11" />
                <Label fx:id="statConnectesLabel" styleClass="stat-number, stat-success" text="0" />
            </HBox>
            <Label styleClass="stat-card-label" text="%audit.stats.success" />
            <styleClass>
                <String fx:value="stat-card-compact" />
                <String fx:value="special-container" />
            </styleClass>
        </VBox>

        <!-- Card Refusé -->
        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER" spacing="4">
                <FontIcon iconLiteral="fth-slash" iconSize="11" />
                <Label fx:id="statSuspendusLabel" styleClass="stat-number, stat-danger" text="0" />
            </HBox>
            <Label styleClass="stat-card-label" text="%audit.stats.refused" />
            <styleClass>
                <String fx:value="stat-card-compact" />
                <String fx:value="special-container" />
            </styleClass>
        </VBox>

    </HBox>

    <!-- ===== Tableau du journal (lecture seule) ===== -->
    <TableView fx:id="tableAudit" editable="false" styleClass="custom-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colHorodatage" minWidth="160.0" prefWidth="170.0" styleClass="table-column-header" text="%audit.col.timestamp" />
            <TableColumn fx:id="colAuteur" minWidth="140.0" prefWidth="160.0" styleClass="table-column-header" text="%audit.col.author" />
            <TableColumn fx:id="colAction" minWidth="320.0" prefWidth="420.0" styleClass="table-column-header" text="%audit.col.action" />
            <TableColumn fx:id="colAdresseIp" minWidth="120.0" prefWidth="130.0" styleClass="table-column-header" text="%audit.col.ip" />
            <TableColumn fx:id="colAppareil" minWidth="140.0" prefWidth="160.0" styleClass="table-column-header" text="%audit.col.device" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_LAST_COLUMN" />
        </columnResizePolicy>
        <placeholder>
            <Label styleClass="table-placeholder" text="%audit.value.empty" />
        </placeholder>
        <VBox.margin>
            <Insets />
        </VBox.margin>
    </TableView>

    <!-- Note de bas de page -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <children>
            <Label styleClass="audit-note" text="%audit.note.readonly" />
            <Region HBox.hgrow="ALWAYS" />
            <Pagination fx:id="paginationAudit" maxPageIndicatorCount="5" pageCount="1" styleClass="custom-pagination" />
        </children>
        <padding>
            <Insets bottom="-20.0" top="-20.0" />
        </padding>
        <VBox.margin>
            <Insets bottom="-8.0" top="-8.0" />
        </VBox.margin>
    </HBox>

</VBox>