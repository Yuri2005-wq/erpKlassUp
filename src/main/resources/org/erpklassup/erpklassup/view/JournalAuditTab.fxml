<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" styleClass="card" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.JournalAuditTabController">

    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0" />
    </padding>

    <!-- ===== Filtres du journal ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="page-toolbar">
        <children>
            <!-- Barre de recherche -->
            <HBox alignment="CENTER_LEFT" maxWidth="340.0" prefWidth="340.0" spacing="8.0" styleClass="search-box-light">
                <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-icon-light" />
                <TextField fx:id="searchAudit" promptText="Rechercher par auteur, action..." styleClass="search-field-inner" HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Filtres de date -->
            <DatePicker fx:id="datePickerDebut" promptText="Du" styleClass="date-picker-custom" />
            <DatePicker fx:id="datePickerFin" promptText="Au" styleClass="date-picker-custom" />

            <!-- Type d'action -->
            <ComboBox fx:id="filterTypeAction" maxWidth="180.0" prefWidth="180.0" promptText="Type d'action" styleClass="filter-combo" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Bouton export -->
            <Button fx:id="btnExporterAudit" styleClass="btn-secondary" text="Exporter">
                <graphic>
                    <FontIcon iconLiteral="fth-download" iconSize="14" styleClass="btn-icon" />
                </graphic>
            </Button>
        </children>
    </HBox>

    <!-- ===== Tableau du journal (lecture seule) ===== -->
    <TableView fx:id="tableAudit" editable="false" styleClass="custom-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colHorodatage" minWidth="160.0" prefWidth="170.0" styleClass="table-column-header" text="Horodatage" />
            <TableColumn fx:id="colAuteur" minWidth="140.0" prefWidth="160.0" styleClass="table-column-header" text="Auteur" />
            <TableColumn fx:id="colAction" minWidth="320.0" prefWidth="420.0" styleClass="table-column-header" text="Action" />
            <TableColumn fx:id="colAdresseIp" minWidth="120.0" prefWidth="130.0" styleClass="table-column-header" text="Adresse IP" />
            <TableColumn fx:id="colAppareil" minWidth="140.0" prefWidth="160.0" styleClass="table-column-header" text="Appareil" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_LAST_COLUMN" />
        </columnResizePolicy>
        <placeholder>
            <Label styleClass="table-placeholder" text="Aucun enregistrement dans le journal d'audit" />
        </placeholder>
    </TableView>

    <!-- Note de bas de page -->
    <Label styleClass="audit-note" text="⚠ Ce journal est en lecture seule à des fins de conformité et de sécurité." />

</VBox>
