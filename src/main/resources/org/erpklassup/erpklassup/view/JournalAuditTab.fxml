<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" styleClass="rbac-tab-content"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.erpklassup.erpklassup.controller.JournalAuditTabController">

    <!-- ===== Filtres du journal ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="rbac-toolbar">

        <StackPane styleClass="search-field-container">
            <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-field-icon" StackPane.alignment="CENTER_LEFT" />
            <TextField fx:id="searchAudit" promptText="Rechercher par auteur, action..." styleClass="search-field" />
        </StackPane>

        <DatePicker fx:id="datePickerDebut" promptText="Du" styleClass="filter-date" />
        <DatePicker fx:id="datePickerFin" promptText="Au" styleClass="filter-date" />

        <ComboBox fx:id="filterTypeAction" promptText="Type d'action" styleClass="filter-combo" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnExporterAudit" onAction="#handleExporterAudit" styleClass="btn-secondary" text="Exporter">
            <graphic><FontIcon iconLiteral="fth-download" iconSize="14" /></graphic>
        </Button>

    </HBox>

    <!-- ===== Tableau du journal (lecture seule) ===== -->
    <TableView fx:id="tableAudit" editable="false" styleClass="data-table, data-table-readonly" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colHorodatage" minWidth="160.0" prefWidth="170.0" text="Horodatage" />
            <TableColumn fx:id="colAuteur" minWidth="140.0" prefWidth="160.0" text="Auteur" />
            <TableColumn fx:id="colAction" minWidth="320.0" prefWidth="420.0" text="Action" />
            <TableColumn fx:id="colAdresseIp" minWidth="120.0" prefWidth="130.0" text="Adresse IP" />
            <TableColumn fx:id="colAppareil" minWidth="140.0" prefWidth="160.0" text="Appareil" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_LAST_COLUMN" />
        </columnResizePolicy>
    </TableView>

    <Label styleClass="muted-text, italic-text" text="Ce journal est en lecture seule à des fins de conformité et de sécurité." />

</VBox>
