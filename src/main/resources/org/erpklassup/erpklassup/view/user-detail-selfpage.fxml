<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- ✅ RACINE SIMPLIFIÉE : VBox direct, plus de StackPane transparent -->

<VBox prefHeight="577.0" prefWidth="480.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.UserProfileController">

    <stylesheets>
        <URL value="@../style.css" />
    </stylesheets>

    <!-- ===== EN-TÊTE PROFIL ===== -->
    <HBox alignment="CENTER_LEFT" prefHeight="63.0" prefWidth="480.0" spacing="15" style="-fx-background-color: #16213A; -fx-padding: 7 10;">

        <StackPane>
            <Circle fill="#F5A524" radius="28" />
            <Label fx:id="avatarLabel" style="-fx-text-fill: #16213A; -fx-font-size: 16px; -fx-font-weight: bold;" text="MK" />
        </StackPane>

        <VBox spacing="3">
            <Label fx:id="nomCompletLabel" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="—" />
            <Label fx:id="usernameLabel" styleClass="page-subtitle" text="—" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="badgeStatut" styleClass="event-tag, tag-green" text="●" />

        <Button fx:id="btnFermer" onAction="#handleFermer" prefHeight="34.0" prefWidth="0.0" style="-fx-background-color: transparent;                        -fx-text-fill: #94A3B8;                        -fx-font-size: 16px;                        -fx-font-weight: bold;                        -fx-padding: 4 8;                        -fx-cursor: hand;                        -fx-background-radius: 6;" />
    </HBox>

    <!-- ===== TABPANE ===== -->
    <TabPane fx:id="tabPane" styleClass="top-tab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- ONGLET 1 : MES INFORMATIONS -->
        <Tab closable="false" styleClass="top-tab-btn" text="%user_profile.tab.info">
            <ScrollPane fitToWidth="true" styleClass="page-scroll">
                <content>
                    <VBox maxWidth="800" spacing="20" styleClass="content-area">
                        <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                        <VBox spacing="15" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <FontIcon iconLiteral="fth-user" iconSize="18" styleClass="tile-icon" />
                                <Label styleClass="card-title" text="%user_profile.info.title" />
                            </HBox>

                            <HBox spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="field-label" text="%user_profile.field.nom" />
                                    <TextField fx:id="nomField" styleClass="input" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="field-label" text="%user_profile.field.prenom" />
                                    <TextField fx:id="prenomField" styleClass="input" />
                                </VBox>
                            </HBox>

                            <HBox spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="field-label" text="%user_profile.field.email" />
                                    <TextField fx:id="emailField" styleClass="input" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="field-label" text="%user_profile.field.telephone" />
                                    <TextField fx:id="telephoneField" styleClass="input" />
                                </VBox>
                            </HBox>

                            <HBox spacing="15">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="field-label" text="%user_profile.field.langue" />
                                    <ComboBox fx:id="langueCombo" maxWidth="Infinity" styleClass="combo-box" />
                                </VBox>
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label styleClass="field-label" text="%user_profile.field.fuseau" />
                                    <ComboBox fx:id="fuseauCombo" maxWidth="Infinity" styleClass="combo-box" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Button fx:id="btnAnnulerInfo" styleClass="btn-icon-light" text="%common.cancel" />
                            <Button fx:id="btnEnregistrerInfo" styleClass="button-primary" text="%common.save">
                                <graphic><FontIcon iconLiteral="fth-save" iconSize="14" /></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </Tab>

        <!-- ONGLET 2 : SÉCURITÉ -->
        <Tab closable="false" styleClass="top-tab-btn" text="%user_profile.tab.security">
            <ScrollPane fitToWidth="true" styleClass="page-scroll">
                <content>
                    <VBox maxWidth="800" spacing="20" styleClass="content-area">
                        <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                        <VBox spacing="15" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <FontIcon iconLiteral="fth-lock" iconSize="18" styleClass="tile-icon" />
                                <Label styleClass="card-title" text="%user_profile.password.title" />
                            </HBox>

                            <VBox spacing="6">
                                <Label styleClass="field-label" text="%user_profile.password.current" />
                                <PasswordField fx:id="ancienMdpField" promptText="%user_profile.password.current.placeholder" styleClass="input" />
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="field-label" text="%user_profile.password.new" />
                                <PasswordField fx:id="nouveauMdpField" promptText="%user_profile.password.new.placeholder" styleClass="input" />
                            </VBox>

                            <VBox spacing="6">
                                <Label styleClass="field-label" text="%user_profile.password.confirm" />
                                <PasswordField fx:id="confirmMdpField" promptText="%user_profile.password.confirm.placeholder" styleClass="input" />
                            </VBox>

                            <HBox alignment="CENTER_RIGHT">
                                <Button fx:id="btnChangerMdp" styleClass="button-primary" text="%user_profile.password.change">
                                    <graphic><FontIcon iconLiteral="fth-key" iconSize="14" /></graphic>
                                </Button>
                            </HBox>
                        </VBox>

                        <!-- 2FA -->
                        <VBox spacing="15" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <FontIcon iconLiteral="fth-shield" iconSize="18" styleClass="tile-icon" />
                                <Label styleClass="card-title" text="%user_profile.2fa.title" />
                            </HBox>

                            <HBox fx:id="box2FADesactive" alignment="CENTER_LEFT" spacing="20">
                                <VBox spacing="5">
                                    <Label styleClass="field-label" text="%user_profile.2fa.status" />
                                    <Label fx:id="statut2FALabel" style="-fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="%user_profile.2fa.status_disabled" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnActiver2FA" styleClass="btn-icon-light" text="%user_profile.2fa.activate">
                                    <graphic><FontIcon iconLiteral="fth-shield" iconSize="14" /></graphic>
                                </Button>
                            </HBox>

                            <VBox fx:id="boxConfiguration2FA" managed="false" spacing="12" visible="false">
                                <Label styleClass="field-label" text="%user_profile.2fa.scan_qr" wrapText="true" />

                                <HBox alignment="CENTER">
                                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: white;                                                  -fx-padding: 12;                                                  -fx-background-radius: 8;                                                  -fx-border-color: #E2E8F0;                                                  -fx-border-radius: 8;">
                                        <ImageView fx:id="qrCodeImageView" fitHeight="180" fitWidth="180" preserveRatio="true" />
                                        <Label styleClass="footer-info" text="%user_profile.2fa.manual_code" />
                                        <HBox alignment="CENTER" spacing="8">
                                            <TextField fx:id="cleSecreteField" editable="false" prefWidth="240" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11;" styleClass="input" />
                                            <Button fx:id="btnCopierCle" styleClass="btn-icon-light">
                                                <graphic><FontIcon iconLiteral="fth-copy" iconSize="14" /></graphic>
                                            </Button>
                                        </HBox>
                                    </VBox>
                                </HBox>

                                <Label styleClass="field-label" text="%user_profile.2fa.enter_code" />
                                <TextField fx:id="codeVerification2FAField" maxWidth="200" promptText="000000" style="-fx-font-size: 16; -fx-alignment: center;" styleClass="input" />

                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                    <Button fx:id="btnAnnuler2FA" styleClass="btn-icon-light" text="%common.cancel" />
                                    <Button fx:id="btnConfirmer2FA" styleClass="button-primary" text="%user_profile.2fa.validate">
                                        <graphic><FontIcon iconLiteral="fth-check" iconSize="14" /></graphic>
                                    </Button>
                                </HBox>
                            </VBox>

                            <VBox fx:id="box2FAActive" managed="false" spacing="12" visible="false">
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox spacing="5">
                                        <Label styleClass="field-label" text="%user_profile.2fa.status" />
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: #10B981;" text="%user_profile.2fa.status_enabled" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnAfficherCodesSecours" styleClass="btn-icon-light" text="%user_profile.2fa.backup_codes">
                                        <graphic><FontIcon iconLiteral="fth-key" iconSize="14" /></graphic>
                                    </Button>
                                    <Button fx:id="btnDesactiver2FA" styleClass="btn-icon-light" text="%user_profile.2fa.disable">
                                        <graphic><FontIcon iconLiteral="fth-x-circle" iconSize="14" /></graphic>
                                    </Button>
                                </HBox>
                            </VBox>

                            <Label styleClass="footer-info" text="%user_profile.2fa.hint" wrapText="true" />
                        </VBox>

                        <!-- Sessions actives -->
                        <VBox spacing="15" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <FontIcon iconLiteral="fth-monitor" iconSize="18" styleClass="tile-icon" />
                                <Label styleClass="card-title" text="%user_profile.sessions.title" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnDeconnecterAutres" styleClass="btn-icon-light" text="%user_profile.sessions.disconnect_others">
                                    <graphic><FontIcon iconLiteral="fth-log-out" iconSize="14" /></graphic>
                                </Button>
                            </HBox>

                            <TableView fx:id="sessionsTable" prefHeight="150" styleClass="custom-table">
                                <columns>
                                    <TableColumn fx:id="colAppareilSession" prefWidth="200" text="%user_profile.sessions.col.device" />
                                    <TableColumn fx:id="colIpSession" prefWidth="150" text="%user_profile.sessions.col.ip" />
                                    <TableColumn fx:id="colDateSession" prefWidth="180" text="%user_profile.sessions.col.last_activity" />
                                </columns>
                                <placeholder>
                                    <Label styleClass="table-placeholder" text="%user_profile.sessions.empty" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </Tab>

        <!-- ONGLET 3 : MES ACTIVITÉS -->
        <Tab closable="false" styleClass="top-tab-btn" text="%user_profile.tab.activity">
            <ScrollPane fitToWidth="true" styleClass="page-scroll">
                <content>
                    <VBox maxWidth="850" spacing="20" styleClass="content-area">
                        <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                        <VBox spacing="15" styleClass="card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <FontIcon iconLiteral="fth-clock" iconSize="18" styleClass="tile-icon" />
                                <Label styleClass="card-title" text="%user_profile.activity.title" />
                            </HBox>

                            <TableView fx:id="activitesTable" prefHeight="400" styleClass="custom-table">
                                <columns>
                                    <TableColumn fx:id="colDateActivite" prefWidth="150" text="%user_profile.activity.col.date" />
                                    <TableColumn fx:id="colActionActivite" prefWidth="130" text="%user_profile.activity.col.action" />
                                    <TableColumn fx:id="colDetailActivite" prefWidth="380" text="%user_profile.activity.col.details" />
                                    <TableColumn fx:id="colIpActivite" prefWidth="120" text="%user_profile.activity.col.ip" />
                                </columns>
                                <placeholder>
                                    <Label styleClass="table-placeholder" text="%user_profile.activity.empty" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>
        </Tab>

    </TabPane>

    <!-- ===== MODAL DES CODES DE SECOURS (overlay) ===== -->
    <StackPane fx:id="modalCodesSecours" managed="false" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false" StackPane.alignment="CENTER">
        <VBox maxHeight="400" maxWidth="420" spacing="15" style="-fx-background-color: white;                      -fx-padding: 25;                      -fx-background-radius: 12;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 25, 0, 0, 8);">

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16213A;" text="%user_profile.codes.title" />

            <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="%user_profile.codes.warning" wrapText="true" />

            <ListView fx:id="listCodesSecours" prefHeight="200" prefWidth="360" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 13;" />

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnFermerModalCodes" styleClass="button-primary" text="%common.close" />
            </HBox>
        </VBox>
    </StackPane>

</VBox>
