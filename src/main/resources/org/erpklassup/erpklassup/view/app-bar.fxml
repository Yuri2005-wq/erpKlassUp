<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="appBar" alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="1280.0" spacing="15.0" styleClass="app-bar" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.AppBarController">

    <padding>
        <Insets left="16.0" right="8.0" />
    </padding>

    <children>

        <!-- ===== FIL D'ARIANE ===== -->
        <Region maxWidth="280.0" prefWidth="280.0" HBox.hgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="breadcrumb-box">

            <Label fx:id="breadcrumbParent"
                   styleClass="breadcrumb-parent"
                   text=""
                   visible="false" managed="false"/>

            <Label fx:id="breadcrumbSeparator1"
                   styleClass="breadcrumb-separator"
                   text="›"
                   visible="false" managed="false"/>

            <Label fx:id="breadcrumbSection"
                   styleClass="breadcrumb-section"
                   text=""/>

            <Label fx:id="breadcrumbSeparator2"
                   styleClass="breadcrumb-separator"
                   text="›"
                   visible="false" managed="false"/>

            <Label fx:id="breadcrumbSousSection"
                   styleClass="breadcrumb-sub"
                   text=""
                   visible="false" managed="false"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- ===== ZONE D'INFORMATIONS DU SYSTÈME ET PROFIL ===== -->
        <HBox alignment="CENTER" spacing="16.0">
            <children>

                <!-- 1. Indicateur de Statut Réseau / Cloud -->
                <HBox alignment="CENTER" spacing="6.0" styleClass="status-badge, status-online">
                    <children>
                        <Circle fx:id="statusDot" radius="4.0" styleClass="status-dot" />
                        <Label fx:id="lblStatus" styleClass="status-text" text="En ligne" />
                    </children>
                </HBox>

                <Region styleClass="bar-divider" />

                <!-- 2. Date du Jour -->
                <HBox alignment="CENTER" spacing="6.0" styleClass="info-badge">
                    <children>
                        <FontIcon iconLiteral="fth-calendar" iconSize="13" styleClass="app-bar-icon" />
                        <Label fx:id="lblDate" styleClass="app-bar-text" text="Jeu. 20 Août 2026" />
                    </children>
                </HBox>

                <Region styleClass="bar-divider" />

                <!-- 3. ✅ NOUVEAU — Badge Année Active -->
                <HBox fx:id="anneeActiveBadge" alignment="CENTER" spacing="6.0"
                      styleClass="info-badge, annee-active-badge"
                      onMouseClicked="#handleChangerAnnee">
                    <children>
                        <Circle fx:id="anneeActiveDot" radius="4.0"
                                styleClass="annee-active-dot" />
                        <Label fx:id="lblAnneeActive" styleClass="annee-active-text"
                               text="—" />
                    </children>
                </HBox>

                <Region styleClass="bar-divider" />

                <!-- 4. Commutateur de Langue (FR / EN) -->
                <HBox alignment="CENTER" styleClass="lang-selector">
                    <children>
                        <ToggleButton fx:id="btnLangFr" selected="true" styleClass="lang-btn, lang-btn-left" text="FR">
                            <toggleGroup>
                                <ToggleGroup fx:id="langGroup" />
                            </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="btnLangEn" styleClass="lang-btn, lang-btn-right" text="EN" toggleGroup="$langGroup" />
                    </children>
                </HBox>

                <Region styleClass="bar-divider" />

                <!-- 5. Bloc Profil Utilisateur Connecté -->
                <HBox fx:id="userProfilBox" alignment="CENTER_LEFT" onMouseClicked="#handleOuvrirProfil" prefHeight="50.0" prefWidth="173.0" spacing="10" style="-fx-padding: 6 12; -fx-background-radius: 8; -fx-cursor: hand;">

                    <StackPane style="-fx-min-width: 36; -fx-min-height: 36;                       -fx-max-width: 36; -fx-max-height: 36;                       -fx-background-color: #F5A524;                       -fx-background-radius: 50%;">
                        <Label fx:id="avatarLabelAppBar" style="-fx-text-fill: #16213A; -fx-font-weight: bold; -fx-font-size: 13px;" text="AD" />
                    </StackPane>

                    <VBox spacing="2">
                        <Label fx:id="nomUtilisateurAppBar" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;" text="Admin System" />
                        <Label fx:id="roleUtilisateurAppBar" style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;" text="Super Administrateur" />
                    </VBox>
                </HBox>

            </children>
        </HBox>
    </children>
</HBox>