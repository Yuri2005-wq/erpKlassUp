<HBox fx:id="appBar" alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="1280.0" spacing="15.0" styleClass="app-bar" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.AppBarController">

    <padding>
        <Insets left="16.0" right="8.0" />
    </padding>

    <children>

        <Region HBox.hgrow="ALWAYS" />

        <!-- ===== ZONE DESINFORMATIONS DU SYSTÈME ET PROFIL ===== -->
        <HBox alignment="CENTER" spacing="16.0">
            <children>

                <!-- 1. Indicateur de Statut Réseau / Cloud -->
                <HBox alignment="CENTER" spacing="6.0" styleClass="status-badge, status-online">
                    <children>
                        <Circle fx:id="statusDot" radius="4.0" styleClass="status-dot" />
                        <Label fx:id="lblStatus" styleClass="status-text" text="En ligne" />
                    </children>
                </HBox>

                <!-- Séparateur visuel léger -->
                <Region styleClass="bar-divider" />

                <!-- 2. Date du Jour -->
                <HBox alignment="CENTER" spacing="6.0" styleClass="info-badge">
                    <children>
                        <FontIcon iconLiteral="fth-calendar" iconSize="13" styleClass="app-bar-icon" />
                        <Label fx:id="lblDate" styleClass="app-bar-text" text="Jeu. 20 Août 2026" />
                    </children>
                </HBox>

                <!-- Séparateur visuel léger -->
                <Region styleClass="bar-divider" />

                <!-- 3. Commutateur de Langue (FR / EN) -->
                <HBox alignment="CENTER" styleClass="lang-selector">
                    <children>
                        <ToggleButton fx:id="btnLangFr" selected="true" styleClass="lang-btn, lang-btn-left" text="FR">
                            <toggleGroup>
                                <ToggleGroup fx:id="langGroup" />
                            </toggleGroup>
                        </ToggleButton>
                        <ToggleButton fx:id="btnLangEn" styleClass="lang-btn, lang-btn-right" text="EN" toggleGroup="$langGroup" />
                    </children>
                </HBox>

                <!-- Séparateur visuel léger -->
                <Region styleClass="bar-divider" />

                <!-- 4. Bloc Profil Utilisateur Connecté -->
                <HBox alignment="CENTER" spacing="10.0" styleClass="user-profile-box">
                    <children>
                        <Label fx:id="lblUserAvatar" styleClass="avatar-badge" text="AD" />
                        <VBox alignment="CENTER_LEFT" spacing="0.0">
                            <children>
                                <Label fx:id="lblUsername" styleClass="user-name" text="Admin System" />
                                <Label fx:id="lblUserRole" styleClass="user-role" text="Super Administrateur" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

            </children>
        </HBox>

        <!-- Spacer de sécurité avant les contrôles de fenêtre -->
        <Region prefHeight="49.0" prefWidth="38.0" />

        <!-- ===== BOUTONS DE CONTRÔLE DE LA FENÊTRE ===== -->
        <HBox alignment="CENTER" spacing="2.0" styleClass="window-controls" />
    </children>
</HBox>
