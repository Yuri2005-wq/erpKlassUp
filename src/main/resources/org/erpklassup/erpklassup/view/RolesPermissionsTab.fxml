<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<SplitPane fx:id="rolesSplitPane" dividerPositions="0.28" styleClass="rbac-split-pane" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.RolesPermissionsTabController">

    <items>

        <VBox alignment="CENTER" spacing="10.0" styleClass="roles-list-panel">
            <padding>
                <Insets bottom="4.0" left="4.0" right="10.0" top="4.0" />
            </padding>
            <children>
                <Label styleClass="panel-title" text="Rôles" />
                <ListView fx:id="listRoles" styleClass="special-container" VBox.vgrow="ALWAYS" />
                <Button fx:id="btnNouveauRole" styleClass="button-primary" text="Créer un nouveau rôle">
                    <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" styleClass="btn-icon" /></graphic>
                </Button>
            </children>
        </VBox>

        <VBox spacing="12.0" styleClass="permissions-panel">
            <padding>
                <Insets bottom="4.0" left="14.0" right="4.0" top="4.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="labelRoleSelectionne" styleClass="panel-title" text="Sélectionnez un rôle" />
                        <Label fx:id="labelRoleDescription" styleClass="muted-text" text="Les droits ci-dessous s'appliquent à tous les utilisateurs de ce rôle." />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnRenommerRole" styleClass="btn-icon-light">
                        <graphic><FontIcon iconLiteral="fth-edit-2" iconSize="14" styleClass="btn-icon" /></graphic>
                    </Button>
                    <Button fx:id="btnSupprimerRole" styleClass="btn-icon-light, btn-danger-icon">
                        <graphic><FontIcon iconLiteral="fth-trash-2" iconSize="14" styleClass="btn-icon" /></graphic>
                    </Button>
                </HBox>

                <!-- Généré dynamiquement depuis la table Permission -->
                <ScrollPane fitToWidth="true" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <Accordion fx:id="accordionModules" styleClass="permissions-accordion" />
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="permissions-save-bar">
                    <Label fx:id="labelModificationsNonEnregistrees" styleClass="warning-text" text="" />
                    <Button fx:id="btnAnnulerPermissions" styleClass="btn-icon-light" text="Annuler" />
                    <Button fx:id="btnEnregistrerPermissions" prefHeight="3.0" prefWidth="183.0" styleClass="button-primary" text="Enregistrer les droits">
                        <graphic><FontIcon iconLiteral="fth-save" iconSize="14" styleClass="btn-icon" /></graphic>
                    </Button>
                </HBox>

            </children>
        </VBox>

    </items>

</SplitPane>
