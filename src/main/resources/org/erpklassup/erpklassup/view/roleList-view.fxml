<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../style.css"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.erpklassup.erpklassup.controllers.actionPage.UserProfileController">

    <VBox style="-fx-background-color: #111a2e;">

        <!-- ===== EN-TÊTE PROFIL ===== -->
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #16213A; -fx-padding: 15 20;">
            <StackPane>
                <Circle fill="#F5A524" radius="28"/>
                <Label fx:id="avatarLabel" text="MK" style="-fx-text-fill: #16213A; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            </StackPane>
            <VBox spacing="3">
                <Label fx:id="nomCompletLabel" text="KAMDEM Marie" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="usernameLabel" text="@mkamdem" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="badgeStatut" text="● Actif" styleClass="event-tag, tag-green"/>
        </HBox>

        <!-- ===== TABPANE ===== -->
        <TabPane fx:id="tabPane" styleClass="top-tab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

            <!-- ===== ONGLET 1 : MES INFORMATIONS ===== -->
            <Tab closable="false" styleClass="top-tab-btn" text="Mes informations">
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                    <content>
                        <VBox maxWidth="800" spacing="20" styleClass="content-area">
                            <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

                            <!-- Section : Informations personnelles -->
                            <VBox spacing="15" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <FontIcon iconLiteral="fth-user" iconSize="18" styleClass="tile-icon"/>
                                    <Label styleClass="card-title" text="Informations personnelles"/>
                                </HBox>

                                <HBox spacing="15">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="field-label" text="Nom"/>
                                        <TextField fx:id="nomField" styleClass="input"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="field-label" text="Prénom"/>
                                        <TextField fx:id="prenomField" styleClass="input"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="15">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="field-label" text="Email"/>
                                        <TextField fx:id="emailField" styleClass="input"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="field-label" text="Téléphone"/>
                                        <TextField fx:id="telephoneField" styleClass="input"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="15">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="field-label" text="Langue préférée"/>
                                        <ComboBox fx:id="langueCombo" maxWidth="Infinity" styleClass="combo-box"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label styleClass="field-label" text="Fuseau horaire"/>
                                        <ComboBox fx:id="fuseauCombo" maxWidth="Infinity" styleClass="combo-box"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- Section : Rôles (lecture seule) -->
                            <VBox spacing="15" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <FontIcon iconLiteral="fth-shield" iconSize="18" styleClass="tile-icon"/>
                                    <Label styleClass="card-title" text="Mes rôles et accès"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="Lecture seule" styleClass="footer-info"/>
                                </HBox>

                                <FlowPane fx:id="rolesFlowPane" hgap="10" vgap="10" prefWrapLength="700"/>

                                <Label text="Ces informations sont gérées par l'administrateur. Contactez-le pour toute modification."
                                       styleClass="footer-info" wrapText="true"/>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT" spacing="10">
                                <Button fx:id="btnAnnulerInfo" styleClass="btn-icon-light" text="Annuler"/>
                                <Button fx:id="btnEnregistrerInfo" styleClass="button-primary" text="Enregistrer les modifications">
                                    <graphic><FontIcon iconLiteral="fth-save" iconSize="14"/></graphic>
                                </Button>
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <!-- ===== ONGLET 2 : SÉCURITÉ ===== -->
            <Tab closable="false" styleClass="top-tab-btn" text="Sécurité">
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                    <content>
                        <VBox maxWidth="800" spacing="20" styleClass="content-area">
                            <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

                            <!-- Section : Changer mot de passe -->
                            <VBox spacing="15" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <FontIcon iconLiteral="fth-lock" iconSize="18" styleClass="tile-icon"/>
                                    <Label styleClass="card-title" text="Changer mon mot de passe"/>
                                </HBox>

                                <VBox spacing="6">
                                    <Label styleClass="field-label" text="Mot de passe actuel *"/>
                                    <PasswordField fx:id="ancienMdpField" promptText="Saisissez votre mot de passe actuel" styleClass="input"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label styleClass="field-label" text="Nouveau mot de passe *"/>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <PasswordField fx:id="nouveauMdpField" promptText="Minimum 8 caractères" HBox.hgrow="ALWAYS" styleClass="input"/>
                                        <Button fx:id="btnTogglePassword" styleClass="btn-icon-light">
                                            <graphic><FontIcon iconLiteral="fth-eye" iconSize="14"/></graphic>
                                        </Button>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="Force :" styleClass="footer-info"/>
                                        <Label fx:id="forceMdpLabel" text="—" style="-fx-font-weight: bold;"/>
                                        <ProgressBar fx:id="forceMdpProgress" prefWidth="150" prefHeight="6" styleClass="kpi-progress" visible="false"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="6">
                                    <Label styleClass="field-label" text="Confirmer le nouveau mot de passe *"/>
                                    <PasswordField fx:id="confirmMdpField" promptText="Retapez le nouveau mot de passe" styleClass="input"/>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT">
                                    <Button fx:id="btnChangerMdp" styleClass="button-primary" text="Changer le mot de passe">
                                        <graphic><FontIcon iconLiteral="fth-key" iconSize="14"/></graphic>
                                    </Button>
                                </HBox>
                            </VBox>

                            <!-- Section : Double authentification -->
                            <VBox spacing="15" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <FontIcon iconLiteral="fth-shield" iconSize="18" styleClass="tile-icon"/>
                                    <Label styleClass="card-title" text="Double authentification (2FA)"/>
                                </HBox>

                                <HBox spacing="20" alignment="CENTER_LEFT">
                                    <VBox spacing="5">
                                        <Label text="Statut 2FA" styleClass="field-label"/>
                                        <Label fx:id="statut2FALabel" text="Non activée" style="-fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnActiver2FA" styleClass="btn-icon-light" text="Activer la 2FA">
                                        <graphic><FontIcon iconLiteral="fth-shield" iconSize="14"/></graphic>
                                    </Button>
                                </HBox>

                                <Label text="La double authentification ajoute une couche de sécurité supplémentaire à votre compte."
                                       styleClass="footer-info" wrapText="true"/>
                            </VBox>

                            <!-- Section : Mes sessions actives -->
                            <VBox spacing="15" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <FontIcon iconLiteral="fth-monitor" iconSize="18" styleClass="tile-icon"/>
                                    <Label styleClass="card-title" text="Mes sessions actives"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnDeconnecterAutres" styleClass="btn-icon-light" text="Déconnecter les autres">
                                        <graphic><FontIcon iconLiteral="fth-log-out" iconSize="14"/></graphic>
                                    </Button>
                                </HBox>

                                <TableView fx:id="sessionsTable" prefHeight="150" styleClass="custom-table">
                                    <columns>
                                        <TableColumn fx:id="colAppareilSession" text="APPAREIL" prefWidth="200"/>
                                        <TableColumn fx:id="colIpSession" text="ADRESSE IP" prefWidth="150"/>
                                        <TableColumn fx:id="colDateSession" text="DERNIÈRE ACTIVITÉ" prefWidth="180"/>
                                    </columns>
                                    <placeholder><Label text="Aucune session active" styleClass="table-placeholder"/></placeholder>
                                </TableView>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <!-- ===== ONGLET 3 : MES ACTIVITÉS ===== -->
            <Tab closable="false" styleClass="top-tab-btn" text="Mes activités">
                <ScrollPane fitToWidth="true" styleClass="page-scroll">
                    <content>
                        <VBox maxWidth="850" spacing="20" styleClass="content-area">
                            <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

                            <VBox spacing="15" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <FontIcon iconLiteral="fth-clock" iconSize="18" styleClass="tile-icon"/>
                                    <Label styleClass="card-title" text="Historique de mes actions"/>
                                </HBox>

                                <TableView fx:id="activitesTable" prefHeight="400" styleClass="custom-table">
                                    <columns>
                                        <TableColumn fx:id="colDateActivite" text="DATE" prefWidth="150"/>
                                        <TableColumn fx:id="colActionActivite" text="ACTION" prefWidth="130"/>
                                        <TableColumn fx:id="colDetailActivite" text="DÉTAILS" prefWidth="380"/>
                                        <TableColumn fx:id="colIpActivite" text="IP" prefWidth="120"/>
                                    </columns>
                                    <placeholder><Label text="Aucune activité récente" styleClass="table-placeholder"/></placeholder>
                                </TableView>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

        </TabPane>

    </VBox>
</StackPane>