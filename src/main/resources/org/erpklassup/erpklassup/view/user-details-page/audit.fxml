<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="15" styleClass="card" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.renduView.UserAuditTabController">

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <FontIcon iconLiteral="fth-clock" iconSize="18" styleClass="tile-icon"/>
        <Label text="Historique de l'utilisateur" styleClass="card-title"/>
    </HBox>

    <TableView fx:id="auditTable" VBox.vgrow="ALWAYS" styleClass="custom-table">
        <columns>
            <TableColumn fx:id="colDate" text="DATE" prefWidth="150"/>
            <TableColumn fx:id="colAction" text="ACTION" prefWidth="200"/>
            <TableColumn fx:id="colDetail" text="DÉTAILS" prefWidth="300"/>
            <TableColumn fx:id="colIp" text="ADRESSE IP" prefWidth="120"/>
        </columns>
        <placeholder><Label text="Aucun historique" styleClass="table-placeholder"/></placeholder>
    </TableView>

</VBox>