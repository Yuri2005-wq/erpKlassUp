<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20" styleClass="card" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.renduView.UserInfoTabController">

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <!-- En-tête avec avatar -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <StackPane>
            <Circle fill="#16213A" radius="35"/>
            <Label fx:id="avatarLabel" text="TK" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </StackPane>
        <VBox spacing="5">
            <Label fx:id="nomCompletLabel" text="TCHOUA Sandrine" styleClass="card-title"/>
            <Label fx:id="usernameLabel" text="@admin" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="badgeStatut" text="Actif" styleClass="event-tag, tag-green"/>
    </HBox>

    <Separator/>

    <!-- Formulaire -->
    <GridPane hgap="15" vgap="15">
        <Label text="Nom *" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField" styleClass="input" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Prénom" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="prenomField" styleClass="input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Username *" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" styleClass="input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Email *" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" styleClass="input" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Téléphone" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="telephoneField" styleClass="input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Type" styleClass="field-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeUserCombo" maxWidth="Infinity" styleClass="input" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS"/>

    <!-- Boutons -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnAnnuler" styleClass="btn-icon-light" text="Annuler"/>
        <Button fx:id="btnEnregistrer" styleClass="button-primary" text="Enregistrer">
            <graphic><FontIcon iconLiteral="fth-save" iconSize="14"/></graphic>
        </Button>
    </HBox>

</VBox>