<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="15" styleClass="card" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.renduView.UserPermissionsTabController">

    <padding><Insets bottom="20" left="20" right="20" top="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <FontIcon iconLiteral="fth-key" iconSize="18" styleClass="tile-icon"/>
        <Label text="Permissions d'exception" styleClass="card-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="permCountLabel" text="0 sélectionnée(s)" styleClass="footer-info"/>
    </HBox>

    <Label text="Permissions supplémentaires au-delà des rôles :" styleClass="field-label" wrapText="true"/>

    <!-- Recherche -->
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box-light">
        <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-icon-light"/>
        <TextField fx:id="searchPermissionField" promptText="Rechercher une permission..." styleClass="search-field-inner" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Liste des permissions -->
    <ScrollPane fitToWidth="true" prefHeight="350" styleClass="page-scroll">
        <content>
            <VBox fx:id="permissionsContainer" spacing="5"/>
        </content>
    </ScrollPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnEnregistrerPermissions" styleClass="button-primary" text="Enregistrer les permissions">
            <graphic><FontIcon iconLiteral="fth-save" iconSize="14"/></graphic>
        </Button>
    </HBox>

</VBox>