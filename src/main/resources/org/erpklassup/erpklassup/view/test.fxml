<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="14.0" styleClass="card" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.UtilisateursView">

    <!-- ===== Barre d'outils : recherche + filtres + actions ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="rbac-toolbar">

        <!-- Recherche instantanée -->
        <StackPane styleClass="search-field-container">
            <FontIcon iconLiteral="fth-search" iconSize="14" styleClass="search-field-icon" StackPane.alignment="CENTER_LEFT" />
            <TextField fx:id="searchField" prefHeight="28.0" prefWidth="378.0" promptText="Rechercher un nom, un email, un identifiant..." styleClass="input" />
            <Button fx:id="btnClearSearch" visible="false" styleClass="btn-icon-light" StackPane.alignment="CENTER_RIGHT">
                <graphic>
                    <FontIcon iconLiteral="fth-x" iconSize="12" />
                </graphic>
            </Button>
        </StackPane>

        <ComboBox fx:id="filterRole" prefHeight="36.0" promptText="Rôle" />
        <ComboBox fx:id="filterStatut" prefHeight="34.0" promptText="Statut" styleClass="combo-box" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnActionsGroupees" prefHeight="0.0" prefWidth="146.0" styleClass="button-primary" text="Actions par lot">
            <graphic><FontIcon iconLiteral="fth-layers" iconSize="14" /></graphic>
        </Button>

        <Button fx:id="btnAjouterUtilisateur" contentDisplay="LEFT" styleClass="button-primary" text="Ajouter un utilisateur">
            <graphic><FontIcon iconLiteral="fth-user-plus" iconSize="15" /></graphic>
        </Button>

    </HBox>

    <!-- ===== Tableau des utilisateurs ===== -->
    <TableView fx:id="tableUtilisateurs" styleClass="custom-table" VBox.vgrow="ALWAYS">
        <columns>

            <TableColumn fx:id="colSelect" maxWidth="40.0" minWidth="40.0" prefWidth="40.0" sortable="false">
                <graphic><CheckBox fx:id="checkAllUsers" styleClass="remember-checkbox" /></graphic>
            </TableColumn>

            <TableColumn fx:id="colUtilisateur" minWidth="240.0" prefWidth="280.0" text="Utilisateur" />

            <TableColumn fx:id="colRole" minWidth="140.0" prefWidth="150.0" text="Rôle" />

            <TableColumn fx:id="colStatut" minWidth="110.0" prefWidth="120.0" text="Statut" />

            <TableColumn fx:id="colSecurite" maxWidth="90.0" minWidth="90.0" prefWidth="90.0" sortable="false" text="2FA" />

            <TableColumn fx:id="colDerniereConnexion" minWidth="160.0" prefWidth="170.0" text="Dernière connexion" />

            <!-- Nouvelle colonne Actions -->
            <TableColumn fx:id="colActions" maxWidth="110.0" minWidth="110.0" prefWidth="110.0" sortable="false" text="Actions" />

        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_LAST_COLUMN" />
        </columnResizePolicy>
    </TableView>

    <!-- ===== Pied de tableau : compteur + pagination ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="rbac-table-footer">
        <Label fx:id="labelCompteurResultats" styleClass="muted-text" text="0 utilisateur(s)" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

</VBox>


