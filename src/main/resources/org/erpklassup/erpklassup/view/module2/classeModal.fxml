<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefWidth="540.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 15, 0, 0, 8);" stylesheets="@../../style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.erpklassup.erpklassup.controllers.actionPage.module2.ClasseModalController">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>

    <children>

        <!-- ===== En-tête ===== -->
        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <children>
                <FontIcon fx:id="iconModal" iconLiteral="fas-chalkboard" iconSize="40" styleClass="icon-orange" />
                <VBox spacing="4.0">
                    <children>
                        <Label fx:id="lblTitreModal" text="Nouvelle classe" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblSousTitreModal" text="Renseignez les informations de la classe" textFill="#64748B">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
         <VBox.margin>
            <Insets bottom="-15.0" top="-15.0" />
         </VBox.margin>
        </HBox>

        <Separator />

        <!-- ===== Formulaire ===== -->
        <VBox spacing="16.0">
            <children>

                <!-- Code + Capacité -->
                <HBox spacing="12.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Code classe *" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtCodeClasse" promptText="ex: 6E1, TleD2" styleClass="input" />
                                <Label fx:id="errCodeClasse" managed="false" styleClass="field-error" visible="false" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Capacité *" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtCapacite" promptText="40" styleClass="input" />
                                <Label fx:id="errCapacite" managed="false" styleClass="field-error" visible="false" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Nom de la classe -->
                <VBox spacing="6.0">
                    <children>
                        <Label text="Nom de la classe *" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtNomClasse" promptText="ex: 6ème 1, Terminale D2" styleClass="input" />
                        <Label fx:id="errNomClasse" managed="false" styleClass="field-error" visible="false" />
                    </children>
                </VBox>

                <!-- Niveau + Filière -->
                <HBox spacing="12.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Niveau *" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="comboNiveau" maxWidth="Infinity" styleClass="combo-box" />
                                <Label fx:id="errNiveau" managed="false" styleClass="field-error" visible="false" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Filière" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="comboFiliere" maxWidth="Infinity" styleClass="combo-box" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Année + Vacation -->
                <HBox spacing="12.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Vacation *" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="comboVacation" maxWidth="Infinity" styleClass="combo-box" />
                                <Label fx:id="errVacation" managed="false" styleClass="field-error" visible="false" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Titulaire -->
                <VBox spacing="6.0">
                    <children>
                        <Label text="Enseignant titulaire" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="comboTitulaire" maxWidth="Infinity" styleClass="combo-box" />
                    </children>
                </VBox>

                <!-- Salle -->
                <VBox spacing="6.0">
                    <children>
                        <Label text="Salle" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="comboSalle" maxWidth="Infinity" styleClass="combo-box" />
                    </children>
                </VBox>

                <!-- Erreur globale -->
                <Label fx:id="errGlobal" managed="false" styleClass="error-label" visible="false" wrapText="true" />

            </children>
        </VBox>

        <!-- ===== Actions ===== -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button fx:id="btnAnnuler" onAction="#handleAnnuler" styleClass="btn-icon-light" text="Annuler">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="btnEnregistrer" defaultButton="true" onAction="#handleEnregistrer" styleClass="button-primary" text="Enregistrer">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                        <graphic>
                            <FontIcon iconLiteral="fth-save" iconSize="12" styleClass="icon-orange" />
                        </graphic>
                </Button>
            </children>
            <VBox.margin>
                <Insets top="8.0" />
            </VBox.margin>
        </HBox>

    </children>
</VBox>
