<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.tonapp.controller.ClasseController"
           fx:id="rootPane"
           stylesheets="@../css/classe.css"
           styleClass="app-root">

    <VBox spacing="0" styleClass="main-container">

        <!-- ============ HEADER ============ -->
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <FontIcon iconLiteral="fth-building" iconSize="28" styleClass="header-icon"/>
            <VBox spacing="2">
                <Label text="Gestion des Classes" styleClass="page-title"/>
                <Label text="Créer, modifier et organiser les classes de votre établissement"
                       styleClass="page-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField" promptText="Rechercher une classe…"
                       styleClass="search-field" prefWidth="280">
                <graphic><FontIcon iconLiteral="fth-search" iconSize="16"/></graphic>
            </TextField>

            <Button fx:id="btnRefresh" styleClass="btn-icon" onAction="#onRefresh">
                <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="18"/></graphic>
                <tooltip><Tooltip text="Rafraîchir"/></tooltip>
            </Button>

            <Button fx:id="btnAdd" text="Nouvelle classe" styleClass="btn-primary"
                    onAction="#onAddClasse">
                <graphic><FontIcon iconLiteral="fth-plus" iconSize="16" styleClass="icon-on-primary"/></graphic>
            </Button>
        </HBox>

        <!-- ============ BARRE DE FILTRES ============ -->
        <HBox styleClass="filter-bar" spacing="12" alignment="CENTER_LEFT">
            <padding><Insets top="0" right="32" bottom="16" left="32"/></padding>

            <ComboBox fx:id="cbAnnee" promptText="Année scolaire" styleClass="filter-combo" prefWidth="180"/>
            <ComboBox fx:id="cbNiveau" promptText="Niveau" styleClass="filter-combo" prefWidth="180"/>
            <ComboBox fx:id="cbVacation" promptText="Vacation" styleClass="filter-combo" prefWidth="180"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblCount" text="0 classe(s)" styleClass="count-badge"/>
        </HBox>

        <!-- ============ TABLEAU ============ -->
        <VBox VBox.vgrow="ALWAYS" styleClass="table-wrapper">
            <padding><Insets top="0" right="32" bottom="24" left="32"/></padding>

            <TableView fx:id="table" styleClass="modern-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCode" text="CODE" prefWidth="110"/>
                    <TableColumn fx:id="colNom" text="NOM DE LA CLASSE" prefWidth="220"/>
                    <TableColumn fx:id="colNiveau" text="NIVEAU" prefWidth="140"/>
                    <TableColumn fx:id="colFiliere" text="FILIÈRE" prefWidth="160"/>
                    <TableColumn fx:id="colSalle" text="SALLE" prefWidth="120"/>
                    <TableColumn fx:id="colTitulaire" text="TITULAIRE" prefWidth="200"/>
                    <TableColumn fx:id="colVacation" text="VACATION" prefWidth="160"/>
                    <TableColumn fx:id="colCapacite" text="CAPACITÉ" prefWidth="100"/>
                    <TableColumn fx:id="colActions" text="" prefWidth="120" sortable="false"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <FontIcon iconLiteral="fth-inbox" iconSize="48" styleClass="empty-icon"/>
                        <Label text="Aucune classe trouvée" styleClass="empty-text"/>
                        <Label text="Cliquez sur « Nouvelle classe » pour commencer"
                               styleClass="empty-subtext"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>

    <!-- ============ OVERLAY (fond sombre) ============ -->
    <Region fx:id="overlay" styleClass="overlay" visible="false" managed="false"/>

    <!-- ============ DRAWER FORMULAIRE ============ -->
    <VBox fx:id="drawer" styleClass="drawer" maxWidth="520" prefWidth="520"
          StackPane.alignment="CENTER_RIGHT" visible="false" managed="false">

        <!-- En-tête du drawer -->
        <HBox styleClass="drawer-header" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="24" right="24" bottom="24" left="28"/></padding>
            <FontIcon fx:id="drawerIcon" iconLiteral="fth-plus-circle" iconSize="22" styleClass="drawer-icon"/>
            <VBox spacing="2">
                <Label fx:id="drawerTitle" text="Nouvelle classe" styleClass="drawer-title"/>
                <Label fx:id="drawerSubtitle" text="Renseignez les informations ci-dessous"
                       styleClass="drawer-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button styleClass="btn-close" onAction="#onCloseDrawer">
                <graphic><FontIcon iconLiteral="fth-x" iconSize="18"/></graphic>
            </Button>
        </HBox>

        <Separator/>

        <!-- Formulaire -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="drawer-scroll">
            <VBox spacing="18" styleClass="form-body">
                <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

                <!-- Section : Identification -->
                <Label text="IDENTIFICATION" styleClass="section-label"/>

                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Code classe *" styleClass="field-label"/>
                        <TextField fx:id="tfCode" promptText="ex: 6EME-A" styleClass="form-field"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Capacité *" styleClass="field-label"/>
                        <TextField fx:id="tfCapacite" promptText="40" styleClass="form-field"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Nom de la classe *" styleClass="field-label"/>
                    <TextField fx:id="tfNom" promptText="ex: Sixième A" styleClass="form-field"/>
                </VBox>

                <!-- Section : Affectations -->
                <Label text="AFFECTATIONS" styleClass="section-label"/>

                <VBox spacing="6">
                    <Label text="École *" styleClass="field-label"/>
                    <ComboBox fx:id="cbEcole" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Niveau *" styleClass="field-label"/>
                        <ComboBox fx:id="cbFormNiveau" maxWidth="Infinity" styleClass="form-field"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Filière" styleClass="field-label"/>
                        <ComboBox fx:id="cbFormFiliere" maxWidth="Infinity" styleClass="form-field"/>
                    </VBox>
                </HBox>

                <HBox spacing="14">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Année scolaire *" styleClass="field-label"/>
                        <ComboBox fx:id="cbFormAnnee" maxWidth="Infinity" styleClass="form-field"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Vacation *" styleClass="field-label"/>
                        <ComboBox fx:id="cbFormVacation" maxWidth="Infinity" styleClass="form-field"/>
                    </VBox>
                </HBox>

                <VBox spacing="6">
                    <Label text="Enseignant titulaire" styleClass="field-label"/>
                    <ComboBox fx:id="cbTitulaire" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Salle" styleClass="field-label"/>
                    <ComboBox fx:id="cbSalle" maxWidth="Infinity" styleClass="form-field"/>
                </VBox>

                <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"
                       wrapText="true"/>
            </VBox>
        </ScrollPane>

        <Separator/>

        <!-- Pied du drawer -->
        <HBox styleClass="drawer-footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="18" right="28" bottom="18" left="28"/></padding>
            <Button text="Annuler" styleClass="btn-ghost" onAction="#onCloseDrawer"/>
            <Button fx:id="btnSave" text="Enregistrer" styleClass="btn-primary" onAction="#onSave">
                <graphic><FontIcon iconLiteral="fth-check" iconSize="16" styleClass="icon-on-primary"/></graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>