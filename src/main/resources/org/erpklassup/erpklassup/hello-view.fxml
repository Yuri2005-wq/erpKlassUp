<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="root-pane"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.erpklassup.erpklassup.HelloController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <!-- ===== Barre de fenêtre personnalisée ===== -->
    <top>
        <fx:include source="view/app-bar.fxml" />
    </top>

    <!-- ===== Sidebar avec sous-menus extensibles ===== -->
    <left>
        <StackPane fx:id="sidebarContainer" minWidth="200.0" prefWidth="280.0" maxWidth="400.0" styleClass="sidebar">
            <children>
                <VBox spacing="8.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="20.0" left="12.0" />
                    </padding>
                    <children>

                        <!-- Header / Logo -->
                        <HBox alignment="CENTER" spacing="12.0" styleClass="sidebar-header">
                            <padding><Insets bottom="15.0" /></padding>
                            <ImageView fitHeight="65.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@logo.png" />
                                </image>
                            </ImageView>
                        </HBox>

                        <!-- Menu avec sous-menus extensibles -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="2.0">

                                    <!-- ===== 1. PILOTAGE ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.pilotage" />

                                    <Button fx:id="btnDashboard" onAction="#handleDashboardHome" prefWidth="Infinity" styleClass="nav-item, active" text="%sidebar.dashboard">
                                        <graphic><FontIcon iconLiteral="fth-grid" iconSize="16" /></graphic>
                                    </Button>

                                    <!-- ===== 2. VIE SCOLAIRE ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.vie_scolaire" />

                                    <!-- Menu Élèves avec sous-menu -->
                                    <VBox spacing="1.0">
                                        <Button fx:id="btnStudents" onAction="#toggleSousMenu" prefWidth="Infinity" styleClass="nav-item">
                                            <graphic>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                                                    <FontIcon iconLiteral="fth-users" iconSize="16" />
                                                    <Label text="%sidebar.students" HBox.hgrow="ALWAYS" style="-fx-text-fill: inherit;" />
                                                    <FontIcon fx:id="chevronStudents" iconLiteral="fth-chevron-down" iconSize="12" />
                                                </HBox>
                                            </graphic>
                                        </Button>
                                        <VBox fx:id="sousMenuStudents" spacing="1.0" managed="false" visible="false" styleClass="sous-menu">
                                            <Button onAction="#handleNouvelleInscription" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.new_inscription">
                                                <graphic><FontIcon iconLiteral="fth-plus-circle" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleListeEleves" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.students_list">
                                                <graphic><FontIcon iconLiteral="fth-list" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleReinscriptions" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.reinscriptions">
                                                <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleDossiersEleves" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.students_files">
                                                <graphic><FontIcon iconLiteral="fth-folder" iconSize="14" /></graphic>
                                            </Button>
                                        </VBox>
                                    </VBox>

                                    <!-- Menu Présences avec sous-menu -->
                                    <VBox spacing="1.0">
                                        <Button fx:id="btnPresences" onAction="#toggleSousMenu" prefWidth="Infinity" styleClass="nav-item">
                                            <graphic>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                                                    <FontIcon iconLiteral="fth-calendar" iconSize="16" />
                                                    <Label text="%sidebar.presences" HBox.hgrow="ALWAYS" style="-fx-text-fill: inherit;" />
                                                    <FontIcon fx:id="chevronPresences" iconLiteral="fth-chevron-down" iconSize="12" />
                                                </HBox>
                                            </graphic>
                                        </Button>
                                        <VBox fx:id="sousMenuPresences" spacing="1.0" managed="false" visible="false" styleClass="sous-menu">
                                            <Button onAction="#handleFeuilleAppel" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.attendance">
                                                <graphic><FontIcon iconLiteral="fth-check-square" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleRetards" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.late_absences">
                                                <graphic><FontIcon iconLiteral="fth-clock" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleStatsAssiduite" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.attendance_stats">
                                                <graphic><FontIcon iconLiteral="fth-bar-chart-2" iconSize="14" /></graphic>
                                            </Button>
                                        </VBox>
                                    </VBox>

                                    <!-- Menu Classes -->
                                    <Button fx:id="btnClasses" onAction="#handleClassesMenu" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.classes">
                                        <graphic><FontIcon iconLiteral="fth-layers" iconSize="16" /></graphic>
                                    </Button>

                                    <!-- ===== 3. PÉDAGOGIE ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.pedagogie" />

                                    <!-- Menu Notes avec sous-menu -->
                                    <VBox spacing="1.0">
                                        <Button fx:id="btnNotes" onAction="#toggleSousMenu" prefWidth="Infinity" styleClass="nav-item">
                                            <graphic>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                                                    <FontIcon iconLiteral="fth-edit-3" iconSize="16" />
                                                    <Label text="%sidebar.notes" HBox.hgrow="ALWAYS" style="-fx-text-fill: inherit;" />
                                                    <FontIcon fx:id="chevronNotes" iconLiteral="fth-chevron-down" iconSize="12" />
                                                </HBox>
                                            </graphic>
                                        </Button>
                                        <VBox fx:id="sousMenuNotes" spacing="1.0" managed="false" visible="false" styleClass="sous-menu">
                                            <Button onAction="#handleSaisieNotes" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.notes_entry">
                                                <graphic><FontIcon iconLiteral="fth-pen-tool" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleBulletins" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.reports">
                                                <graphic><FontIcon iconLiteral="fth-file-text" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleExamens" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.exams">
                                                <graphic><FontIcon iconLiteral="fth-award" iconSize="14" /></graphic>
                                            </Button>
                                        </VBox>
                                    </VBox>

                                    <!-- ===== 4. FINANCES ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.finances" />

                                    <!-- Menu Paiements avec sous-menu -->
                                    <VBox spacing="1.0">
                                        <Button fx:id="btnPaiement" onAction="#toggleSousMenu" prefWidth="Infinity" styleClass="nav-item">
                                            <graphic>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                                                    <FontIcon iconLiteral="fth-dollar-sign" iconSize="16" />
                                                    <Label text="%sidebar.payments" HBox.hgrow="ALWAYS" style="-fx-text-fill: inherit;" />
                                                    <FontIcon fx:id="chevronPaiement" iconLiteral="fth-chevron-down" iconSize="12" />
                                                </HBox>
                                            </graphic>
                                        </Button>
                                        <VBox fx:id="sousMenuPaiement" spacing="1.0" managed="false" visible="false" styleClass="sous-menu">
                                            <Button onAction="#handleGuichet" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.cash_desk">
                                                <graphic><FontIcon iconLiteral="fth-credit-card" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleFraisInscription" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.registration_fees">
                                                <graphic><FontIcon iconLiteral="fth-file-plus" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleRecouvrement" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.recovery">
                                                <graphic><FontIcon iconLiteral="fth-pie-chart" iconSize="14" /></graphic>
                                            </Button>
                                            <Button onAction="#handleFactures" prefWidth="Infinity" styleClass="nav-item, sous-item" text="%submenu.invoices">
                                                <graphic><FontIcon iconLiteral="fth-printer" iconSize="14" /></graphic>
                                            </Button>
                                        </VBox>
                                    </VBox>

                                    <!-- Menu Comptabilité -->
                                    <Button fx:id="btnComptabilite" onAction="#handleComptabilite" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.accounting">
                                        <graphic><FontIcon iconLiteral="fth-book" iconSize="16" /></graphic>
                                    </Button>

                                    <!-- ===== 5. RESSOURCES HUMAINES ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.rh" />

                                    <Button fx:id="btnPersonnel" onAction="#handlePersonnel" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.personnel">
                                        <graphic><FontIcon iconLiteral="fth-user-check" iconSize="16" /></graphic>
                                    </Button>

                                    <Button fx:id="btnPaie" onAction="#handlePaie" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.payroll">
                                        <graphic><FontIcon iconLiteral="fth-briefcase" iconSize="16" /></graphic>
                                    </Button>

                                    <!-- ===== 6. COMMUNICATION ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.communication" />

                                    <Button fx:id="btnMessages" onAction="#handleMessages" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.messages">
                                        <graphic><FontIcon iconLiteral="fth-message-circle" iconSize="16" /></graphic>
                                    </Button>

                                    <Button fx:id="btnDocuments" onAction="#handleDocuments" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.documents">
                                        <graphic><FontIcon iconLiteral="fth-file-text" iconSize="16" /></graphic>
                                    </Button>

                                    <!-- ===== 7. SYSTÈME ===== -->
                                    <Label styleClass="nav-section-label" text="%sidebar.systeme" />

                                    <Button fx:id="btnSettings" onAction="#handleSettings" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.settings">
                                        <graphic><FontIcon iconLiteral="fth-settings" iconSize="16" /></graphic>
                                    </Button>

                                    <Button fx:id="btnUtilisateurs" onAction="#handleUtilisateurs" prefWidth="Infinity" styleClass="nav-item" text="%sidebar.users">
                                        <graphic><FontIcon iconLiteral="fth-shield" iconSize="16" /></graphic>
                                    </Button>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- Bouton Déconnexion au bas -->
                        <Button fx:id="btnLogout" onAction="#handleLogout" prefWidth="Infinity" styleClass="nav-item, logout-item" text="%sidebar.logout">
                            <graphic><FontIcon iconLiteral="fth-log-out" iconSize="16" /></graphic>
                        </Button>

                    </children>
                </VBox>

                <!-- Poignée de redimensionnement à droite (Resize Handle) -->
                <Region fx:id="resizeHandle" prefWidth="6.0" minWidth="6.0" maxWidth="6.0" StackPane.alignment="CENTER_RIGHT" styleClass="sidebar-resize-handle" />
            </children>
        </StackPane>
    </left>

    <!-- ===== Zone de contenu centrale ===== -->
    <center>
        <VBox style="-fx-background-color: -color-bg-subtle;">
            <StackPane fx:id="contentArea" prefHeight="713.0" prefWidth="1020.0" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>